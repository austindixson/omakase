#!/bin/bash
# Omakase workspace indicator — native Mac menu bar only.
#
# Workspaces (1–4 + scratch). No clock, battery, weather, wordmark,
# front app, or theme name. Apple already owns clock / battery.
# Themes still color the pills; they paint borders + Ghostty separately.
#
# Drop at: ~/.config/sketchybar/sketchybarrc
# Then:    brew services start sketchybar
# Switch:  omakase-theme cycle   (or Super+Ctrl+Shift+Space)
#
# Locked: workspace-only overlay. No Quickshell clone. No Omarchy chrome.

CONFIG_DIR="${CONFIG_DIR:-${HOME}/.config/sketchybar}"
PLUGIN_DIR="${CONFIG_DIR}/plugins"

# shellcheck disable=SC1091
source "${CONFIG_DIR}/colors.sh"

FONT="SF Pro:Bold:12.0"

# Transparent strip over the native 24px menu bar. No blur, no chrome.
sketchybar --bar \
  height=24 \
  position=top \
  sticky=on \
  padding_left=8 \
  padding_right=8 \
  color=0x00000000 \
  border_color=0x00000000 \
  blur_radius=0 \
  shadow=off \
  y_offset=0

sketchybar --default \
  icon.font="${FONT}" \
  icon.color="${BAR_MUTED:-0xff8a8278}" \
  label.drawing=off \
  padding_left=4 \
  padding_right=4 \
  background.corner_radius=4 \
  background.height=16 \
  background.drawing=off

sketchybar --add event aerospace_workspace_change

for sid in 1 2 3 4 scratch; do
  icon="${sid}"
  if [ "${sid}" = "scratch" ]; then
    icon="s"
  fi
  sketchybar --add item "space.${sid}" left \
    --subscribe "space.${sid}" aerospace_workspace_change \
    --set "space.${sid}" \
      icon="${icon}" \
      icon.color="${BAR_MUTED:-0xff8a8278}" \
      background.color="${BAR_SURFACE:-0xff2a2722}" \
      click_script="aerospace workspace ${sid}" \
      script="${PLUGIN_DIR}/spaces.sh"
done

sketchybar --update

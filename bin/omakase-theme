#!/bin/bash
# Switch the one Omakase theme across workspace pills, JankyBorders, and Ghostty.
#
#   omakase-theme              cycle Kyoto → Mocha → Ume → Kyoto
#   omakase-theme cycle        same
#   omakase-theme kyoto|mocha|ume
#   omakase-theme list|current
#
# Super+Ctrl+Shift+Space runs `cycle` via AeroSpace exec-and-forget.
set -euo pipefail

STATE_DIR="${OMAKASE_STATE:-${HOME}/.config/omakase}"
CURRENT_LINK="${STATE_DIR}/current"

usage() {
  echo "usage: omakase-theme [list|current|cycle|kyoto|mocha|ume]" >&2
  exit 2
}

catalog_dir() {
  if [ -d "${STATE_DIR}/themes" ]; then
    printf '%s\n' "${STATE_DIR}/themes"
    return
  fi
  printf '%s\n' "$(cd "$(dirname "$0")/../config/themes" && pwd)"
}

current_name() {
  if [ -L "${CURRENT_LINK}" ] || [ -d "${CURRENT_LINK}" ]; then
    basename "$(readlink "${CURRENT_LINK}" || printf '%s\n' "${CURRENT_LINK}")"
    return
  fi
  printf '%s\n' "kyoto"
}

paint_borders() {
  # shellcheck disable=SC1091
  source "${CURRENT_LINK}/theme.sh"
  command -v borders >/dev/null 2>&1 || return 0
  borders \
    style=round \
    width=5.0 \
    hidpi=on \
    active_color="${BORDER_ACTIVE}" \
    inactive_color="${BORDER_INACTIVE}"
}

paint_bar() {
  command -v sketchybar >/dev/null 2>&1 || return 0
  sketchybar --reload
}

point_ghostty() {
  local src="$1"
  mkdir -p "${HOME}/.config/ghostty"
  ln -sfn "${src}/ghostty.conf" "${HOME}/.config/ghostty/omakase-theme"
  if [ -f "${HOME}/.config/ghostty/config" ]; then
    touch "${HOME}/.config/ghostty/config"
  fi
}

apply_name() {
  local name="$1"
  local src
  src="$(catalog_dir)/${name}"
  if [ ! -d "${src}" ]; then
    echo "unknown theme: ${name}" >&2
    exit 1
  fi

  mkdir -p "${STATE_DIR}"
  ln -sfn "${src}" "${CURRENT_LINK}"
  point_ghostty "${src}"
  paint_bar
  paint_borders
  echo "${name}"
}

cycle() {
  case "$(current_name)" in
    kyoto) apply_name mocha ;;
    mocha) apply_name ume ;;
    ume) apply_name kyoto ;;
    *) apply_name kyoto ;;
  esac
}

cmd="${1:-cycle}"
case "${cmd}" in
  list)
    printf '%s\n' kyoto mocha ume
    ;;
  current)
    current_name
    ;;
  cycle)
    cycle
    ;;
  kyoto|mocha|ume)
    apply_name "${cmd}"
    ;;
  *)
    usage
    ;;
esac

#!/bin/bash
# Non-interactive v0 proof driver. Recording stays human.
#
#   omakase-proof-demo           Mac: aerospace + launch / theme / agent
#   omakase-proof-demo --print   print the plan; do not exec
#
# Does not install. Does not disable Spotlight. Does not capture video.
# Does not lock the screen. Super+Space UI is printed, not opened
# (a prompt would stall the take).
#
# Shot list: docs/proof-video.md
# Functions stay small (Clue: McCabe well under 13).
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
LAUNCH="${ROOT}/bin/omakase-launch"
THEME="${ROOT}/bin/omakase-theme"
AGENT="${ROOT}/bin/omakase-agent"
PRINT=0

usage() {
  echo "usage: omakase-proof-demo [--print]" >&2
  exit 2
}

parse_args() {
  PRINT=0
  case "${1:-}" in
    '') ;;
    --print|-n) PRINT=1 ;;
    -h|--help) usage ;;
    *) usage ;;
  esac
}

die() {
  echo "omakase-proof-demo: $*" >&2
  exit 1
}

say() {
  printf '%s\t%s\n' "$1" "$2"
}

pause() {
  if [ "${PRINT}" = 1 ]; then
    return 0
  fi
  sleep "${PROOF_PAUSE:-1}"
}

title() {
  if [ "${PRINT}" = 1 ]; then
    return 0
  fi
  printf '\n== %s ==\n' "$1"
}

require_print_or_mac() {
  if [ "${PRINT}" = 1 ]; then
    return 0
  fi
  if [ "$(uname -s)" = Darwin ]; then
    return 0
  fi
  die "run on macOS, or pass --print"
}

require_aerospace() {
  if [ "${PRINT}" = 1 ]; then
    return 0
  fi
  if command -v aerospace >/dev/null 2>&1; then
    return 0
  fi
  die "need aerospace on PATH (or pass --print)"
}

require_bins() {
  if [ -x "${LAUNCH}" ] && [ -x "${THEME}" ] && [ -x "${AGENT}" ]; then
    return 0
  fi
  die "missing omakase-launch / omakase-theme / omakase-agent next to this script"
}

aero() {
  if [ "${PRINT}" = 1 ]; then
    say aerospace "$*"
    return 0
  fi
  aerospace "$@"
}

run_launch() {
  if [ "${PRINT}" = 1 ]; then
    say launch "$1"
    return 0
  fi
  "${LAUNCH}" "$1"
}

run_theme() {
  if [ "${PRINT}" = 1 ]; then
    say theme "$1"
    return 0
  fi
  "${THEME}" "$1"
}

run_agent() {
  if [ "${PRINT}" = 1 ]; then
    say agent "$1"
    return 0
  fi
  "${AGENT}" "$1"
}

# Super+Space is a human chord. Opening the panel would block the take.
run_launch_ui() {
  say launch ui
  if [ "${PRINT}" = 1 ]; then
    return 0
  fi
  "${LAUNCH}" --print ui
}

shot_human() {
  title "cold + install (human)"
  say note "cold: csrutil status — SIP enabled. No prior AeroSpace / SketchyBar / launcher, or wipe those configs."
  say note "install: ./bin/install. Wall-clock on. Then required: uncheck Spotlight Show Spotlight search."
}

shot_windows() {
  title "tiling"
  run_launch terminal
  pause
  run_launch files
  pause
}

shot_super() {
  title "super binds"
  aero workspace 2
  pause
  aero workspace 1
  pause
  aero focus right
  pause
  aero move left
  pause
  aero layout floating tiling
  pause
  aero layout floating tiling
  pause
}

shot_launcher() {
  title "launcher"
  run_launch_ui
  pause
}

shot_agent() {
  title "Option+Enter primary"
  run_agent list
  pause
  run_agent primary
  pause
}

shot_theme() {
  title "theme cycle"
  run_theme kyoto
  pause
  run_theme cycle
  pause
  run_theme cycle
}

main() {
  parse_args "$@"
  require_bins
  require_print_or_mac
  require_aerospace
  shot_human
  shot_windows
  shot_super
  shot_launcher
  shot_agent
  shot_theme
}

main "$@"

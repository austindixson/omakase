#!/bin/bash
# Focus or launch local coding agents. Omakase is not an AI OS.
#
#   omakase-agent pick         Super+Shift+Ctrl+A — menu of what is here
#   omakase-agent primary      Super+Ctrl+Return — default local agent
#   omakase-agent list
#   omakase-agent current
#   … --print                  print the launch plan; do not exec
#
# Detects apps and CLIs already on this Mac. Never installs. Never
# talks to a marketplace. Captain override: ~/.config/omakase/agents.conf
#
# Super+Shift+Ctrl+A / Super+Ctrl+Return run pick / primary via AeroSpace
# exec-and-forget (same /bin/bash -lc path as the theme switcher).
set -euo pipefail

STATE_DIR="${OMAKASE_STATE:-${HOME}/.config/omakase}"
CONF="${STATE_DIR}/agents.conf"

PRINT=0
PRIMARY_OVERRIDE=""
AGENT_CWD="${HOME}"
EXTRAS=()
AVAILABLE=()
_id=""
_label=""
_kind=""
_target=""

usage() {
  echo "usage: omakase-agent [pick|primary|list|current] [--print]" >&2
  exit 2
}

load_conf() {
  [ -f "${CONF}" ] || return 0
  local line key val
  while IFS= read -r line || [ -n "${line}" ]; do
    case "${line}" in
      ''|'#'*) continue ;;
    esac
    key="${line%%=*}"
    val="${line#*=}"
    case "${key}" in
      primary) PRIMARY_OVERRIDE="${val}" ;;
      cwd) AGENT_CWD="${val/#\~/${HOME}}" ;;
      extra) EXTRAS+=("${val}") ;;
      *) echo "omakase-agent: unknown agents.conf key: ${key}" >&2 ;;
    esac
  done < "${CONF}"
}

app_exists() {
  local name="$1"
  local roots=("/Applications" "${HOME}/Applications")
  local root
  [ -n "${OMAKASE_APP_ROOT:-}" ] && roots+=("${OMAKASE_APP_ROOT}")
  for root in "${roots[@]}"; do
    [ -d "${root}/${name}.app" ] && return 0
  done
  return 1
}

cursor_cli_bin() {
  if command -v cursor-agent >/dev/null 2>&1; then
    command -v cursor-agent
    return 0
  fi
  if [ -x "${HOME}/.local/bin/cursor-agent" ]; then
    printf '%s\n' "${HOME}/.local/bin/cursor-agent"
    return 0
  fi
  # Official CLI binary can be `agent`; only claim it when the Cursor tree is here.
  if [ -d "${HOME}/.local/share/cursor-agent" ] && [ -x "${HOME}/.local/bin/agent" ]; then
    printf '%s\n' "${HOME}/.local/bin/agent"
    return 0
  fi
  return 1
}

add() {
  AVAILABLE+=("$1|$2|$3|$4")
}

split_row() {
  local rest="$1"
  _id="${rest%%|*}"
  rest="${rest#*|}"
  _label="${rest%%|*}"
  rest="${rest#*|}"
  _kind="${rest%%|*}"
  _target="${rest#*|}"
}

find_id() {
  local want="$1" row
  for row in "${AVAILABLE[@]}"; do
    split_row "${row}"
    if [ "${_id}" = "${want}" ]; then
      printf '%s\n' "${row}"
      return 0
    fi
  done
  return 1
}

discover() {
  AVAILABLE=()
  if app_exists Cursor; then
    add cursor "Cursor" app "Cursor"
  fi

  local bin
  if bin="$(cursor_cli_bin)"; then
    add cursor-cli "Cursor Agent CLI" cli "${bin}"
  fi

  for bin in aider claude codex copilot; do
    if command -v "${bin}" >/dev/null 2>&1; then
      add "${bin}" "${bin}" cli "$(command -v "${bin}")"
    fi
  done

  local extra extra_id extra_label extra_kind extra_target
  [ "${#EXTRAS[@]}" -eq 0 ] && return 0
  for extra in "${EXTRAS[@]}"; do
    extra_id="${extra%%|*}"
    extra="${extra#*|}"
    extra_label="${extra%%|*}"
    extra="${extra#*|}"
    extra_kind="${extra%%|*}"
    extra_target="${extra#*|}"
    if [ -z "${extra_id}" ] || [ -z "${extra_kind}" ] || [ -z "${extra_target}" ]; then
      echo "omakase-agent: skip malformed extra= (id|label|kind|target)" >&2
      continue
    fi
    [ -n "${extra_label}" ] || extra_label="${extra_id}"
    add "${extra_id}" "${extra_label}" "${extra_kind}" "${extra_target}"
  done
}

resolve_primary() {
  local row
  if [ -n "${PRIMARY_OVERRIDE}" ]; then
    if row="$(find_id "${PRIMARY_OVERRIDE}")"; then
      printf '%s\n' "${row}"
      return 0
    fi
    echo "omakase-agent: primary=${PRIMARY_OVERRIDE} is not available" >&2
  fi
  if [ "${#AVAILABLE[@]}" -gt 0 ]; then
    printf '%s\n' "${AVAILABLE[0]}"
    return 0
  fi
  return 1
}

none_found() {
  local msg
  msg="No local coding agent found. Install Cursor, or a CLI already on PATH (cursor-agent, aider, claude, codex, copilot), or add extra= to ~/.config/omakase/agents.conf. Omakase will not install one."
  if [ "${PRINT}" = 1 ]; then
    echo "none" >&2
    echo "${msg}" >&2
    exit 1
  fi
  if command -v osascript >/dev/null 2>&1; then
    osascript -e "display dialog \"${msg}\" buttons {\"OK\"} default button \"OK\" with title \"Omakase\"" >/dev/null
  else
    echo "omakase-agent: ${msg}" >&2
  fi
  exit 1
}

launch_app() {
  local name="$1"
  if command -v open >/dev/null 2>&1; then
    open -a "${name}"
    return 0
  fi
  echo "omakase-agent: open(1) missing; would launch app ${name}" >&2
  exit 1
}

launch_cli() {
  local cmd="$1"
  local dir="${AGENT_CWD:-${HOME}}"
  if [ ! -d "${dir}" ]; then
    dir="${HOME}"
  fi

  local ghostty=""
  if command -v ghostty >/dev/null 2>&1; then
    ghostty="$(command -v ghostty)"
  elif [ -x "/Applications/Ghostty.app/Contents/MacOS/ghostty" ]; then
    ghostty="/Applications/Ghostty.app/Contents/MacOS/ghostty"
  fi

  if [ -n "${ghostty}" ]; then
    # Login shell so Homebrew / ~/.local/bin are on PATH. Ghostty is the
    # Omakase terminal; -e is its run-this-command flag.
    "${ghostty}" -e /bin/bash -lc "cd $(printf '%q' "${dir}") && exec ${cmd}" &
    return 0
  fi

  if command -v osascript >/dev/null 2>&1; then
    osascript - "${dir}" "${cmd}" <<'APPLESCRIPT'
on run argv
  set theDir to item 1 of argv
  set theCmd to item 2 of argv
  tell application "Terminal"
    activate
    do script "cd " & quoted form of theDir & " && " & theCmd
  end tell
end run
APPLESCRIPT
    return 0
  fi

  echo "omakase-agent: no Ghostty or Terminal to launch: ${cmd}" >&2
  exit 1
}

launch_row() {
  split_row "$1"
  if [ "${PRINT}" = 1 ]; then
    printf '%s\t%s\t%s\t%s\n' "${_id}" "${_kind}" "${_target}" "${AGENT_CWD}"
    return 0
  fi
  case "${_kind}" in
    app) launch_app "${_target}" ;;
    cli) launch_cli "${_target}" ;;
    *)
      echo "omakase-agent: unknown kind ${_kind} (want app or cli)" >&2
      exit 1
      ;;
  esac
}

pick_row() {
  local row labels="" result
  if [ -n "${OMAKASE_AGENT_PICK:-}" ]; then
    if row="$(find_id "${OMAKASE_AGENT_PICK}")"; then
      printf '%s\n' "${row}"
      return 0
    fi
    echo "omakase-agent: OMAKASE_AGENT_PICK=${OMAKASE_AGENT_PICK} is not available" >&2
    exit 1
  fi

  if command -v osascript >/dev/null 2>&1 && [ "${PRINT}" != 1 ]; then
    for row in "${AVAILABLE[@]}"; do
      split_row "${row}"
      if [ -z "${labels}" ]; then
        labels="\"${_label}\""
      else
        labels="${labels}, \"${_label}\""
      fi
    done
    result="$(osascript -e "choose from list {${labels}} with prompt \"Pick a local coding agent\" OK button name \"Open\" cancel button name \"Cancel\" with title \"Omakase\"")" || true
    if [ "${result}" = "false" ] || [ -z "${result}" ]; then
      exit 0
    fi
    for row in "${AVAILABLE[@]}"; do
      split_row "${row}"
      if [ "${_label}" = "${result}" ]; then
        printf '%s\n' "${row}"
        return 0
      fi
    done
    echo "omakase-agent: unknown pick ${result}" >&2
    exit 1
  fi

  if [ "${PRINT}" = 1 ]; then
    printf '%s\n' "${AVAILABLE[0]}"
    return 0
  fi

  echo "omakase-agent: no picker UI (need osascript). Candidates:" >&2
  cmd_list >&2
  echo "set OMAKASE_AGENT_PICK=<id> or run on a Mac" >&2
  exit 1
}

cmd_list() {
  local row
  if [ "${#AVAILABLE[@]}" -eq 0 ]; then
    return 0
  fi
  for row in "${AVAILABLE[@]}"; do
    split_row "${row}"
    printf '%s\t%s\t%s\t%s\n' "${_id}" "${_label}" "${_kind}" "${_target}"
  done
}

cmd_current() {
  local row
  row="$(resolve_primary)" || none_found
  split_row "${row}"
  printf '%s\n' "${_id}"
}

cmd_primary() {
  local row
  row="$(resolve_primary)" || none_found
  launch_row "${row}"
}

cmd_pick() {
  local row
  [ "${#AVAILABLE[@]}" -gt 0 ] || none_found
  row="$(pick_row)"
  launch_row "${row}"
}

CMD=""
for arg in "$@"; do
  case "${arg}" in
    --print|-n) PRINT=1 ;;
    pick|primary|list|current) CMD="${arg}" ;;
    -h|--help) usage ;;
    *) usage ;;
  esac
done
CMD="${CMD:-list}"

load_conf
discover

case "${CMD}" in
  list) cmd_list ;;
  current) cmd_current ;;
  primary) cmd_primary ;;
  pick) cmd_pick ;;
  *) usage ;;
esac
